+/* ==========================================================================
+   ★ PATCH P0 — زنجیره‌ی «نوارهای چسبان» و سرستونِ کارت‌های ویرایشگر
+   --------------------------------------------------------------------------
+   مشکل: سرستونِ کارت‌های ویرایشگر (همان نوارِ «بخش‌ها (سبک‌ها)» + «افزودن بخش»)
+   `position: static` بود، پس هنگام اسکرول زیرِ نوارِ جمعِ پایین و نوارِ «افزودن»
+   می‌رفت و از دید خارج می‌شد؛ و بنرِ «حالتِ نمایشی» که بالای ویرایشگر است،
+   نوارِ فرمانِ چسبان را جابه‌جا می‌کرد بدونِ این‌که آفست‌ها به‌روز شوند.
+   ========================================================================== */
+:root { --demo-banner-h: 0px; --editor-bar-h: 0px; }
+
+/* بنرِ حالتِ نمایشی هم چسبان شود تا با اسکرول نرود و شکاف نسازد */
+.demo-banner { position: sticky; top: var(--topbar-h); z-index: 29; }
+
+/* نوارِ فرمان: زیرِ نوارِ عنوان + بنر */
+.editor-bar { top: calc(var(--topbar-h) + var(--demo-banner-h)); }
+
+/* ★ نکته‌ی حیاتی: .card با overflow:hidden یک «ظرفِ اسکرول» می‌سازد و
+   position:sticky داخلش هرگز نمی‌چسبد. clip همان برش را می‌دهد بدونِ ظرفِ اسکرول. */
+#page-projects .card { overflow: clip; }
+
+/* سرستونِ کارت‌های ویرایشگر: چسبان، زیرِ همه‌ی نوارهای بالایی */
+#page-projects .card-head {
+  position: sticky;
+  top: calc(var(--topbar-h) + var(--demo-banner-h) + var(--editor-bar-h));
+  z-index: 4;
+  background: var(--surface);
+}
